# Creatora AI environment template. Copy to .env.local and fill in real values.
# Never commit real values. Server-only secrets must never use a NEXT_PUBLIC_ prefix.

# ==================================================
# Required runtime
# ==================================================

# Database (Prisma). DATABASE_URL is the Supabase pooled runtime connection
# (port 6543, pgbouncer=true); DIRECT_URL is the direct/session connection.
# A file: DATABASE_URL activates the SQLite rollback client.
DATABASE_URL=your_database_url
DIRECT_URL=your_direct_database_url

# Application and authentication
# Use the stable deployed origin in Vercel Preview and your production app URL in Production.
APP_URL="http://localhost:3000"
JWT_ACCESS_SECRET=your_jwt_access_secret
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"
AUTH_COOKIE_NAME="creatora_refresh"
AUTH_COOKIE_SECURE="false"

# Encrypts stored OAuth/provider tokens. Must stay identical once data exists.
# Generate a new one only for a fresh environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=your_token_encryption_key

# Transactional email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM_NAME=Creatora AI
EMAIL_FROM_EMAIL=noreply@creatora-ai.online

# Supabase Storage (server-only)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STORAGE_BUCKET=creatora-assets

# Razorpay subscriptions (server-only)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Monthly INR plan IDs. The legacy RAZORPAY_*_MONTHLY_PLAN_ID names are
# accepted as fallbacks, but prefer these *_INR_PLAN_ID names.
RAZORPAY_CREATOR_INR_PLAN_ID=your_razorpay_creator_plan_id
RAZORPAY_PRO_INR_PLAN_ID=your_razorpay_pro_plan_id
RAZORPAY_BUSINESS_INR_PLAN_ID=your_razorpay_business_plan_id

# Google sign-in OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Meta (Facebook/Instagram) OAuth. Add the callback URL below as an exact
# Valid OAuth Redirect URI in the Meta app.
META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret
META_REDIRECT_URI="http://localhost:3000/api/social/meta/callback"
# Recommended: configuration ID from Facebook Login for Business (leave empty if unused).
META_CONFIG_ID=

# LinkedIn OAuth. Enable "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn", then register the exact redirect URI below.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/social/linkedin/callback"
# Keep this Marketing API version current as LinkedIn sunsets older versions.
LINKEDIN_API_VERSION="202609"

# Optional YouTube Data API v3 OAuth. Leave empty to reuse GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET. Enable YouTube Data API v3 with youtube.upload and youtube.readonly.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/youtube/callback"

# ==================================================
# Optional
# ==================================================

# Optional restricted LinkedIn organization scopes after Community Management
# approval, e.g. r_organization_admin w_organization_social.
LINKEDIN_ADDITIONAL_SCOPES=""

# Alternative Supabase secret-key names, used only if SUPABASE_SERVICE_ROLE_KEY is unset.
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# Redis-backed generation queue (e.g. redis://...). Leave empty to run jobs in-process.
REDIS_URL=
# REDIS_CONNECT_TIMEOUT_MS=
# GENERATION_WORKER_CONCURRENCY=2

# MuAPI generation. Optional server-side fallback key; users connect their own MuAPI key.
MUAPI_API_KEY=
MUAPI_CAMPAIGN_IMAGE_MODEL=nano-banana
MUAPI_CAMPAIGN_VIDEO_MODEL=seedance-lite-t2v
MUAPI_CAMPAIGN_VIDEO_MAX_DURATION=12
MUAPI_VIDEO_AUDIO_TEXT_MODEL=minimax-h3-open-text-to-video
MUAPI_VIDEO_AUDIO_IMAGE_MODEL=minimax-h3-open-image-to-video
MUAPI_VIDEO_30S_TEXT_MODEL=seedance-2.5-intl-text-to-video-480p
MUAPI_VIDEO_30S_IMAGE_MODEL=seedance-2.5-intl-omni-reference-480p
MUAPI_TTS_MODEL=minimax-speech-2.6-hd
MUAPI_AVATAR_MODEL=wan2.2-speech-to-video
# MUAPI_AUDIO_MODEL=
# MUAPI_VIDEO_RESOLUTION=
# MUAPI_TTS_TIMEOUT_MS=
# MUAPI_CAMPAIGN_JOB_TIMEOUT_MS=

# KIE provider (optional legacy/secondary provider)
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=wan/3-0-video
KIE_IMAGE_MODEL=gpt-image-2-text-to-image
KIE_VOICE_MODEL=elevenlabs/text-to-speech-turbo-2-5
KIE_MUSIC_MODEL=ai-music-api/generate
# KIE_IMAGE_REFERENCE_MODEL=
# KIE_UPLOAD_BASE_URL=

# OpenAI (campaign planning, transcription, voice briefs)
OPENAI_API_KEY=
OPENAI_CAMPAIGN_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_BRIEF_MODEL=gpt-4.1-mini

# Text-to-speech for voice-over composition
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_MAX_SCRIPT_LENGTH=500

# Provider reliability and media handling
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_MS=3000
PROVIDER_SUBMISSION_TIMEOUT_MS=30000
# PROVIDER_TASK_TIMEOUT_MS=
FINALIZATION_TIMEOUT_MS=600000
MAX_PROVIDER_DOWNLOAD_BYTES=262144000
PROVIDER_CALLBACK_BASE_URL=
# Optional override; the application includes a packaged FFmpeg binary.
FFMPEG_PATH=

# Optional OAuth/API endpoint overrides. Leave commented to use the defaults.
# META_AUTHORIZATION_URL="https://www.facebook.com/dialog/oauth"
# META_TOKEN_URL="https://graph.facebook.com/oauth/access_token"
# META_GRAPH_URL="https://graph.facebook.com"
# META_OAUTH_SCOPES="pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish"
# LINKEDIN_AUTHORIZATION_URL=
# LINKEDIN_TOKEN_URL=
# LINKEDIN_USERINFO_URL=
# LINKEDIN_API_BASE=
# YOUTUBE_AUTHORIZATION_URL=
# YOUTUBE_TOKEN_URL=
# YOUTUBE_CHANNELS_URL=
# YOUTUBE_UPLOAD_URL=

# ==================================================
# Development only (never enable in production)
# ==================================================
AUTH_ALLOW_UNVERIFIED_IN_DEV="false"
# AUTH_ORG_LOGIN_BYPASS="false"
# ALLOW_FREE_VIDEO="false"
# ALLOW_FREE_AVATAR_VIDEO="false"

# ==================================================
# Migration / Maintenance Only (scripts; not used by the running app)
# ==================================================
# Phase 1 SQLite -> PostgreSQL migration and validation scripts.
# SOURCE_DATABASE_URL="file:./prisma/dev.db"
# SOURCE_DATABASE_SHA256=your_verified_backup_checksum
# LEGACY_DATABASE_URL=your_legacy_database_url
# TARGET_DATABASE_URL=your_target_database_url
# TARGET_DIRECT_URL=your_target_direct_database_url
# PHASE1_STAGING_URL="http://127.0.0.1:3011"
# Worker and template-preview scripts.
# CAMPAIGN_WORKER_INTERVAL_MS=
# GENERATION_WORKER_BATCH_SIZE=
# KIE_TEMPLATE_CONCURRENCY=
# KIE_TEMPLATE_LIMIT=
# TEMPLATE_PREVIEW_POLL_INTERVAL_MS=5000
# TEMPLATE_PREVIEW_TIMEOUT_MS=1200000
# Live MuAPI smoke test (scripts/test_minimax_provider.js).
# MUAPI_KEY=your_muapi_api_key
